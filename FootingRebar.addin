<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>ARBA Zapatas</Name>
    <Assembly>FootingRebar\FootingRebar.dll</Assembly>
    <FullClassName>FootingRebar.RibbonApp</FullClassName>
    <ClientId>7d4b2f91-3c6a-4e58-9b1d-2a8f6c0e5d73</ClientId>
